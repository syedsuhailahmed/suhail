
import tensorflow as tf
from tensorflow.keras import layers
import numpy as np
import matplotlib.pyplot as plt

(X, _), _ = tf.keras.datasets.mnist.load_data()
X = np.expand_dims(X / 127.5 - 1, -1)

z_dim = 100
shape = X.shape[1:]

G = tf.keras.Sequential([
    layers.Input((z_dim,)),
    layers.Dense(128, activation="relu"), layers.BatchNormalization(),
    layers.Dense(256, activation="relu"), layers.BatchNormalization(),
    layers.Dense(512, activation="relu"), layers.BatchNormalization(),
    layers.Dense(np.prod(shape), activation="tanh"),
    layers.Reshape(shape)
])

D = tf.keras.Sequential([
    layers.Input(shape), layers.Flatten(),
    layers.Dense(512, activation="relu"),
    layers.Dense(256, activation="relu"),
    layers.Dense(1, activation="sigmoid")
])

D.compile(optimizer=tf.keras.optimizers.Adam(0.0002, 0.5),
          loss="binary_crossentropy", metrics=["accuracy"])

D.trainable = False
inp = layers.Input((z_dim,))
gan = tf.keras.Model(inp, D(G(inp)))
gan.compile(optimizer=tf.keras.optimizers.Adam(0.0002, 0.5),
            loss="binary_crossentropy")

def save_images(epoch):
    imgs = G.predict(np.random.normal(0, 1, (25, z_dim)), verbose=0)
    plt.figure(figsize=(10, 10))
    for i, img in enumerate(imgs):
        plt.subplot(5, 5, i+1)
        plt.imshow(img[:, :, 0] * 0.5 + 0.5, cmap="gray")
        plt.axis("off")
    plt.savefig(f"generated_{epoch}.png")
    plt.show()
    plt.close()

def train(epochs=500, batch=64):
    for e in range(epochs):
        idx = np.random.randint(len(X), size=batch)
        real = X[idx]
        fake = G.predict(np.random.normal(0, 1, (batch, z_dim)), verbose=0)
        D.trainable = True
        d1 = D.train_on_batch(real, np.ones((batch, 1)))
        d2 = D.train_on_batch(fake, np.zeros((batch, 1)))
        D.trainable = False
        g = gan.train_on_batch(np.random.normal(0, 1, (batch, z_dim)),
                               np.ones((batch, 1)))
        print(f"{e+1}/{epochs} D:{(d1[0]+d2[0])/2:.4f} G:{g:.4f}")
        if e % 1000 == 0:
            save_images(e)

train()
